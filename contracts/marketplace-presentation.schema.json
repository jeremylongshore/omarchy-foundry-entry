{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremylongshore/omarchy-foundry-entry/contracts/marketplace-presentation.schema.json",
  "title": "Foundry marketplace presentation contract",
  "type": "object",
  "required": ["id", "name", "version", "description", "barWidget"],
  "properties": {
    "id": { "type": "string", "pattern": "^io\\.github\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 500, "maxLength": 500 },
    "barWidget": {
      "type": "object",
      "required": ["displayName", "description", "category", "allowMultiple"],
      "properties": {
        "description": { "type": "string", "minLength": 500, "maxLength": 500 }
      }
    }
  }
}
