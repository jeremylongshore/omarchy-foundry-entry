#!/usr/bin/env bash
# Foundry's trusted local control plane. It intentionally accepts structured
# fields only. No prompt, README, model response, or copied code is executed.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd -P)"
ACTION="${1:-doctor}"
shift || true

fail() { printf '%s\n' "foundry: $*" >&2; exit 2; }
need() { command -v "$1" >/dev/null 2>&1 || fail "requires $1"; }
need jq

safe_root() {
  local root="${FOUNDRY_ALLOWED_ROOT:-$HOME}"
  [[ -d "$root" ]] || fail "allowed workspace root does not exist"
  cd "$root" && pwd -P
}

inside_root() {
  local root="$1" target="$2"
  [[ "$target" == "$root" || "$target" == "$root"/* ]]
}

doctor() {
  local root template message ready
  root="$(safe_root)"
  template="bundled-bar-widget-v1"
  ready=true
  message="Ready to create a local draft. Foundry never installs or publishes automatically."
  jq -nc --arg template "$template" --arg workspace "$root" --arg message "$message" \
    '{ready:true,template:$template,workspace:$workspace,message:$message,capabilities:"scaffold only",proof:"UNPROVEN"}'
}

write_plugin() {
  local target="$1" id="$2" name="$3" description="$4"
  mkdir -p "$target/tests" "$target/assets"
  jq -nc --arg id "$id" --arg name "$name" --arg description "$description" '
    {schemaVersion:1,id:$id,name:$name,version:"0.1.0",author:"Your name",license:"MIT",description:$description,
     kinds:["bar-widget"],entryPoints:{barWidget:"BarWidget.qml"},
     barWidget:{displayName:$name,description:$description,category:"Developer Tools",aliases:[],allowMultiple:false}}' > "$target/manifest.json"
  cat > "$target/BarWidget.qml" <<'EOF'
import QtQuick
import qs.Commons
import qs.Ui
BarWidget {
  id: root
  moduleName: "REPLACE_MODULE_ID"
  implicitWidth: button.implicitWidth
  implicitHeight: button.implicitHeight
  WidgetButton { id: button; anchors.fill: parent; bar: root.bar; text: "DRAFT"; tooltipText: "Generated by Foundry" }
}
EOF
  sed -i "s/REPLACE_MODULE_ID/$id/g" "$target/BarWidget.qml"
  cat > "$target/Model.js" <<'EOF'
function clean(value, max) {
  var s = String(value === undefined || value === null ? "" : value)
  s = s.replace(/[<>]/g, "").replace(/[\x00-\x1f\x7f]/g, "")
  return s.length > (max || 64) ? s.slice(0, max || 64) : s
}
if (typeof module !== "undefined") module.exports = { clean: clean }
EOF
  cat > "$target/tests/model.test.js" <<'EOF'
const test = require("node:test")
const assert = require("node:assert/strict")
const Model = require("../Model.js")
test("clean removes markup and control characters", () => {
  assert.equal(Model.clean("<b>x</b>\u0000"), "bX/b".replace("X", "x"))
})
EOF
  jq -nc --arg name "$(basename "$target")" '{name:$name,private:true,version:"0.1.0",scripts:{test:"node --test tests/*.test.js"}}' > "$target/package.json"
  cat > "$target/README.md" <<EOF
# $name

$description

Generated locally by Foundry. Review every file before installation or publication.

## Development

Run \`npm test\`, then \`omarchy plugin validate .\`. Install only after reviewing the diff.
EOF
  cat > "$target/LICENSE" <<'EOF'
MIT License

Copyright (c) 2026

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files, to deal in the Software
without restriction, including without limitation the rights to use, copy,
modify, merge, publish, distribute, sublicense, and/or sell copies.
EOF
  cat > "$target/assets/banner.svg" <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="360" role="img" aria-labelledby="title desc"><title id="title">Foundry generated plugin</title><desc id="desc">A blue geometric starter banner</desc><rect width="1280" height="360" fill="#10151d"/><path d="M120 270 300 90l180 180-180 0z" fill="#77b8ff"/><path d="M580 90h520v180H580z" fill="none" stroke="#77b8ff" stroke-width="12"/><path d="M620 180h360" stroke="#354b66" stroke-width="12"/></svg>
EOF
}

create() {
  local workspace="" id="" name="" description="" dry=false root target temp
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --workspace) workspace="${2:-}"; shift 2 ;;
      --id) id="${2:-}"; shift 2 ;;
      --name) name="${2:-}"; shift 2 ;;
      --description) description="${2:-}"; shift 2 ;;
      --dry-run) dry=true; shift ;;
      *) fail "unknown create option: $1" ;;
    esac
  done
  [[ -n "$workspace" && -n "$id" && -n "$name" && -n "$description" ]] || fail "create requires workspace, id, name, and description"
  [[ "$id" =~ ^io\.github\.[a-z0-9-]+\.[a-z0-9-]+$ ]] || fail "id must look like io.github.owner.plugin"
  [[ ${#name} -le 48 && ${#description} -le 160 ]] || fail "name or description is too long"
  [[ -d "$workspace" ]] || fail "workspace does not exist"
  workspace="$(cd "$workspace" && pwd -P)"
  root="$(safe_root)"
  inside_root "$root" "$workspace" || fail "workspace must be inside the selected allowed root"
  target="$workspace/$id"
  [[ ! -e "$target" ]] || fail "target already exists"
  if "$dry"; then
    jq -nc --arg target "$target" --arg id "$id" '{ready:false,target:$target,id:$id,write:false,proof:"UNPROVEN",message:"Dry run only. No files were written."}'
    return
  fi
  temp="$(mktemp -d "$workspace/.foundry.XXXXXX")"
  trap 'rm -rf "$temp"' RETURN
  write_plugin "$temp" "$id" "$name" "$description"
  mv "$temp" "$target"
  trap - RETURN
  jq -nc --arg target "$target" --arg id "$id" '{ready:true,target:$target,id:$id,write:true,proof:"UNPROVEN",message:"Draft created. Review it before any test, install, or publish action."}'
}

case "$ACTION" in
  doctor) [[ "${1:-}" == "--json" || $# -eq 0 ]] || fail "doctor accepts --json"; doctor ;;
  create) create "$@" ;;
  *) fail "use doctor or create" ;;
esac
